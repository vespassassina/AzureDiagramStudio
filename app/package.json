{
  "name": "diagrammer-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:generators": "node --test scripts/generate-brand.test.mjs scripts/generate-vendor.test.mjs scripts/generate-microsoft.test.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "tsc -b --pretty false",
    "test:browser": "node scripts/verify-foundation.mjs",
    "test:desktop": "node --test electron/test/*.test.mjs",
    "desktop:stage": "npm run build && node scripts/stage-desktop.mjs",
    "desktop:pack": "npm run test:desktop && npm run desktop:stage && electron-builder --config electron-builder.config.cjs --win --arm64 --publish never && electron-builder --config electron-builder.config.cjs --win --x64 --publish never",
    "desktop:pack:mac": "npm run test:desktop && npm run desktop:stage && electron-builder --config electron-builder.config.cjs --mac --arm64 --publish never",
    "desktop:verify:mac": "node scripts/verify-mac.mjs",
    "desktop:verify": "node scripts/verify-desktop.mjs",
    "desktop:checksums": "node scripts/desktop-checksums.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "dompurify": "3.4.16",
    "elkjs": "0.12.0",
    "lucide-react": "1.49.0",
    "marked": "18.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
